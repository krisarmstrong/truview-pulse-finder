# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║ TruView Pulse Finder (BigRed WebSocket Client) - .gitignore               ║
# ╠═══════════════════════════════════════════════════════════════════════════╣
# ║ WebSocket client for TruView/BigRed network analysis devices              ║
# ║ Stack: Python 3.x, WebSocket, network monitoring                          ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ─── Python Core ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# ─── Virtual Environments ────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.Python

# ─── Distribution & Packaging ────────────────────────────────────────────────
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ─── Testing & Coverage ──────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/

# ─── Type Checking & Linting ─────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.ruff_cache/

# ─── Environment & Secrets ───────────────────────────────────────────────────
.env
.env.*
.env.local

# Device connection credentials
bigred_*.credentials
truview_config.json

# ─── WebSocket Data ──────────────────────────────────────────────────────────
# Captured WebSocket traffic
ws_captures/
*.wsdata

# Session recordings
sessions/
session_*.json

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
websocket_*.log
bigred_*.log

# ─── Temporary Files ─────────────────────────────────────────────────────────
*.tmp
*.temp
*~
*.swp
*.swo
.tmp_*
